[Unit]
Description=Clone the Agent's repositories into its workspace
Wants=network-online.target
After=network-online.target

[Service]
# Best-effort clones started at boot. `Type=exec` completes the start job once the script has
# started, keeping the clones out of the boot transaction so that
# `systemctl is-system-running --wait` does not wait for them.
Type=exec
User=agent
Group=agent
Environment=HOME=/home/agent
PassEnvironment=GITHUB_TOKEN
ExecStart=/usr/local/libexec/agent-workspace-init

[Install]
WantedBy=multi-user.target
